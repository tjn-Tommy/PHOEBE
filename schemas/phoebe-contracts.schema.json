    "ErrorCode": {
      "description": "Stable machine-readable error classes for the wire (plan §6.4).\n\nValues are part of the serialized contract — never rename them.",
      "enum": [
        "connection",
        "timeout",
        "protocol",
        "device_reported",
        "invalid_state",
        "safety",
        "unsupported_capability",
        "contract",
        "unsupported_model",
        "lease_unavailable",
        "device_not_ready",
        "cancelled",
        "bus_overflow",
        "writer_failed",
        "config",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode",
          "default": "internal"
        },
        "error_type": {
          "title": "Error Type",
          "type": "string"
        },
        "event_type": {
          "const": "error",
          "default": "error",
          "title": "Event Type",
          "type": "string"
        },
        "instrument_id": {
          "anyOf": [
            {
              "type": "string"
