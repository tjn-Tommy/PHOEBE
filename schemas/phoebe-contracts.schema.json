        "t_mono_ns",
        "error_type",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "Structured error attached to acks and events (plan §6.4): clients read\n``code`` and ``instrument_id``; ``message`` is human detail only.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "error_type": {
          "default": "",
          "title": "Error Type",
          "type": "string"
