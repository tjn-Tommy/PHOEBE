{
  "$defs": {
    "AckCode": {
      "description": "Stable dispatch/ack vocabulary (plan §6.4).  Values are part of the\nserialized contract — never rename them.",
      "enum": [
        "accepted",
        "queued",
        "replayed",
        "unknown_command",
        "invalid_payload",
        "command_id_conflict",
        "maintenance_mode",
        "plugin_api_incompatible",
        "missing_role",
        "kind_mismatch",
        "health_stale",
        "device_not_ready",
        "calibration_expired",
        "device_busy",
        "unknown_task",
        "invalid_state",
        "internal_error"
      ],
      "title": "AckCode",
      "type": "string"
    },
    "AdmissionDecision": {
      "additionalProperties": false,
      "description": "Outcome of one admission-chain traversal (plan §6.4): a stable code\nplus human detail.  ``task_id`` is set when a run was created/queued.",
      "properties": {
        "code": {
          "$ref": "#/$defs/AckCode"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "code"
      ],
      "title": "AdmissionDecision",
      "type": "object"
    },
    "ApiEnvelope": {
      "additionalProperties": false,
      "description": "Every ``/api/v1`` response body.  Clients branch on ``status`` for\ncoarse UI (toast/banner) and on the typed payload inside ``data`` for\nlogic — the envelope itself carries zero domain semantics.",
      "properties": {
        "data": {
          "default": null,
          "title": "Data"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "ok",
            "warning",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warning"
        }
      },
      "required": [
        "status"
      ],
      "title": "ApiEnvelope",
      "type": "object"
    },
    "ApiError": {
      "additionalProperties": false,
      "description": "One transport-level failure: HTTP status mirror + stable code +\nhuman detail (never parsed).  ``info`` attributes device/kernel errors\nwhen one caused the failure.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ApiErrorCode"
        },
        "info": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "code",
        "message"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "ApiErrorCode": {
      "description": "Transport-level failure vocabulary.  Values are part of the serialized\ncontract — never rename them.",
      "enum": [
        "unauthorized",
        "forbidden",
        "not_found",
        "validation",
        "unavailable",
        "internal"
      ],
      "title": "ApiErrorCode",
      "type": "string"
    },
    "CommandAck": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "code": {
          "$ref": "#/$defs/AckCode"
        },
        "command_id": {
          "title": "Command Id",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "queued": {
          "default": false,
          "title": "Queued",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "command_id",
        "accepted",
        "code"
      ],
      "title": "CommandAck",
      "type": "object"
    },
    "CommandEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "command_id": {
          "title": "Command Id",
          "type": "string"
        },
        "issued_by": {
          "default": "local_ui",
          "title": "Issued By",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "t_wall": {
          "format": "date-time",
          "title": "T Wall",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "command"
      ],
      "title": "CommandEnvelope",
      "type": "object"
    },
    "ControllerStats": {
      "additionalProperties": false,
      "description": "Operational state for device panels / the future API (plan §3.1 A2).",
      "properties": {
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "ops_failed": {
          "default": 0,
          "title": "Ops Failed",
          "type": "integer"
        },
        "ops_ok": {
          "default": 0,
          "title": "Ops Ok",
          "type": "integer"
        },
        "recent_errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Recent Errors",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "started_at"
      ],
      "title": "ControllerStats",
      "type": "object"
    },
    "DataPointer": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "dataset",
        "index"
      ],
      "title": "DataPointer",
      "type": "object"
    },
    "DataPointerEvent": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "event_type": {
          "const": "data_pointer",
          "default": "data_pointer",
          "title": "Event Type",
          "type": "string"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "preview": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "image": "#/$defs/ImageThumbnail",
                  "scalar_series": "#/$defs/ScalarSeries",
                  "spectrum": "#/$defs/SpectrumPreview",
                  "waveform": "#/$defs/WaveformPreview"
                },
                "propertyName": "preview_type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SpectrumPreview"
                },
                {
                  "$ref": "#/$defs/WaveformPreview"
                },
                {
                  "$ref": "#/$defs/ImageThumbnail"
                },
                {
                  "$ref": "#/$defs/ScalarSeries"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "default": 0,
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "t_mono_ns": {
          "title": "T Mono Ns",
          "type": "integer"
        },
        "t_wall": {
          "format": "date-time",
          "title": "T Wall",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "t_wall",
        "t_mono_ns",
        "run_id",
        "dataset",
        "index"
      ],
      "title": "DataPointerEvent",
      "type": "object"
    },
    "DeviceHealth": {
